generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER_ADMIN
  CASHIER_STORE
  WAREHOUSE_STAFF
}

enum LocationType {
  WAREHOUSE
  STORE
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  POS_SALE
  COD_DISPATCH
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransferStatus {
  DRAFT
  READY
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  FINALIZED
  PARTIALLY_RETURNED
  RETURNED
}

enum PaymentSourceType {
  SALE
  CUSTOMER_ORDER
}

enum PaymentMethod {
  CASH
  QR_NON_CASH
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum LoyaltyTransactionType {
  EARN
  REVERSAL
  ADJUSTMENT
}

enum LoyaltySourceType {
  SALE
  CUSTOMER_ORDER
  MANUAL
}

enum CustomerOrderStatus {
  NEW
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ReservationSourceType {
  CUSTOMER_ORDER
}

enum ReturnSourceType {
  SALE
  CUSTOMER_ORDER
}

enum ReturnKind {
  REFUND
  RECOVERY
}

enum ReturnStatus {
  COMPLETED
}

enum CashMovementType {
  OPENING_CASH
  CASH_ADDED
  EXPENSE
  CASH_PAYOUT
  REFUND_OUT
  OTHER_APPROVED
}

enum CashMovementEffect {
  IN
  OUT
}

enum DailyCloseStatus {
  CLOSED
  REOPENED
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role
  active              Boolean              @default(true)
  sessions            Session[]
  inventoryMovements  InventoryMovement[]
  purchaseReceipts    PurchaseReceipt[]
  transfersCreated    Transfer[]           @relation("TransferCreatedBy")
  transfersDispatched Transfer[]           @relation("TransferDispatchedBy")
  transfersReceived   Transfer[]           @relation("TransferReceivedBy")
  salesFinalized      Sale[]               @relation("SaleFinalizedBy")
  paymentsRecorded    Payment[]            @relation("PaymentRecordedBy")
  loyaltyTransactions LoyaltyTransaction[]
  customerOrdersCreated CustomerOrder[] @relation("CustomerOrderCreatedBy")
  returnsCreated       ReturnRecord[]
  cashMovements        CashMovement[]
  dailyClosesClosed    DailyClose[] @relation("DailyCloseClosedBy")
  dailyClosesReopened  DailyClose[] @relation("DailyCloseReopenedBy")
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Location {
  id                 String              @id @default(uuid())
  code               String              @unique
  name               String
  type               LocationType
  active             Boolean             @default(true)
  stockBalances      StockBalance[]
  inventoryMovements InventoryMovement[]
  transfersFrom      Transfer[]          @relation("TransferFromLocation")
  transfersTo        Transfer[]          @relation("TransferToLocation")
  sales              Sale[]
  customerOrders     CustomerOrder[]
  reservations       InventoryReservation[]
  cashMovements      CashMovement[]
  dailyCloses        DailyClose[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([type, active])
}

model Product {
  id                   String                @id @default(uuid())
  sku                  String                @unique
  barcode              String?               @unique
  name                 String
  category             String
  unit                 String
  costPrice            Decimal               @db.Decimal(12, 2)
  sellingPrice         Decimal               @db.Decimal(12, 2)
  mrp                  Decimal?              @db.Decimal(12, 2)
  warehouseMinStock    Decimal               @default(0) @db.Decimal(14, 3)
  storeMinStock        Decimal               @default(0) @db.Decimal(14, 3)
  active               Boolean               @default(true)
  stockBalances        StockBalance[]
  inventoryMovements   InventoryMovement[]
  purchaseReceiptItems PurchaseReceiptItem[]
  transferItems        TransferItem[]
  saleItems            SaleItem[]
  customerOrderItems   CustomerOrderItem[]
  reservations         InventoryReservation[]
  returnItems          ReturnItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([name])
  @@index([category])
  @@index([active])
}

model StockBalance {
  id         String   @id @default(uuid())
  productId  String
  locationId String
  onHand     Decimal  @default(0) @db.Decimal(14, 3)
  reserved   Decimal  @default(0) @db.Decimal(14, 3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
}

model InventoryMovement {
  id             String                @id @default(uuid())
  productId      String
  locationId     String
  type           InventoryMovementType
  quantityDelta  Decimal               @db.Decimal(14, 3)
  referenceType  String
  referenceId    String
  idempotencyKey String                @unique
  reason         String?
  actorUserId    String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor          User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())

  @@index([productId, locationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorUserId])
}

model Supplier {
  id        String            @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  active    Boolean           @default(true)
  receipts  PurchaseReceipt[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([name])
  @@index([active])
}

model PurchaseReceipt {
  id                String                @id @default(uuid())
  receiptNumber     String                @unique
  supplierId        String?
  supplierReference String?
  status            PurchaseReceiptStatus @default(DRAFT)
  receivedAt        DateTime
  postedAt          DateTime?
  postedByUserId    String?
  notes             String?
  idempotencyKey    String                @unique
  supplier          Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  postedBy          User?                 @relation(fields: [postedByUserId], references: [id], onDelete: Restrict)
  items             PurchaseReceiptItem[]
  createdAt         DateTime              @default(now())

  @@index([status, receivedAt])
  @@index([supplierId, receivedAt])
}

model PurchaseReceiptItem {
  id                String          @id @default(uuid())
  purchaseReceiptId String
  productId         String
  quantity          Decimal         @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseReceiptId, productId])
  @@index([productId])
}

model Transfer {
  id                     String         @id @default(uuid())
  transferNumber         String         @unique
  fromLocationId         String
  toLocationId           String
  status                 TransferStatus @default(DRAFT)
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  createdByUserId        String
  dispatchedByUserId     String?
  receivedByUserId       String?
  notes                  String?
  dispatchIdempotencyKey String?        @unique
  receiveIdempotencyKey  String?        @unique
  fromLocation           Location       @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation             Location       @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdBy              User           @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  dispatchedBy           User?          @relation("TransferDispatchedBy", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  receivedBy             User?          @relation("TransferReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items                  TransferItem[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([fromLocationId, createdAt])
  @@index([toLocationId, createdAt])
}

model TransferItem {
  id                  String   @id @default(uuid())
  transferId          String
  productId           String
  requestedQuantity   Decimal  @db.Decimal(14, 3)
  dispatchedQuantity  Decimal? @db.Decimal(14, 3)
  receivedQuantity    Decimal? @db.Decimal(14, 3)
  discrepancyReason   String?
  transfer            Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
}

model Customer {
  id               String               @id @default(uuid())
  phoneNormalized  String               @unique
  phoneDisplay     String
  name             String?
  notes            String?
  active           Boolean              @default(true)
  loyaltyAccount   LoyaltyAccount?
  loyaltyTransactions LoyaltyTransaction[]
  sales            Sale[]
  customerOrders   CustomerOrder[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([name])
  @@index([active])
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  customerId     String   @unique
  pointBalance   Int      @default(0)
  spendRemainder Decimal  @default(0) @db.Decimal(14, 2)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  updatedAt      DateTime @updatedAt
}

model LoyaltyTransaction {
  id                 String                 @id @default(uuid())
  customerId         String
  type               LoyaltyTransactionType
  pointsDelta        Int
  eligibleSpendDelta Decimal                @db.Decimal(14, 2)
  sourceType         LoyaltySourceType
  sourceId           String
  idempotencyKey     String                 @unique
  reason             String?
  actorUserId        String?
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor              User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())

  @@index([customerId, createdAt])
  @@index([sourceType, sourceId])
}

model Sale {
  id                String        @id @default(uuid())
  receiptNumber     String        @unique
  storeLocationId   String
  customerId        String?
  status            SaleStatus    @default(FINALIZED)
  subtotal          Decimal       @db.Decimal(14, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(14, 2)
  total             Decimal       @db.Decimal(14, 2)
  paymentStatus     PaymentStatus @default(PAID)
  finalizedAt       DateTime
  finalizedByUserId String
  idempotencyKey    String        @unique
  storeLocation     Location      @relation(fields: [storeLocationId], references: [id], onDelete: Restrict)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  finalizedBy       User          @relation("SaleFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: Restrict)
  items             SaleItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([storeLocationId, finalizedAt])
  @@index([finalizedByUserId, finalizedAt])
  @@index([customerId, finalizedAt])
}

model SaleItem {
  id                  String   @id @default(uuid())
  saleId              String
  productId           String
  skuSnapshot         String
  productNameSnapshot String
  quantity            Decimal  @db.Decimal(14, 3)
  unitPrice           Decimal  @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal  @db.Decimal(14, 2)
  unitCostSnapshot    Decimal? @db.Decimal(12, 2)
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleId, productId])
  @@index([productId])
}

model CustomerOrder {
  id                     String              @id @default(uuid())
  orderNumber            String              @unique
  customerId             String
  storeLocationId        String
  status                 CustomerOrderStatus @default(NEW)
  phoneSnapshot          String
  addressText            String
  subtotal               Decimal             @db.Decimal(14, 2)
  discountTotal          Decimal             @default(0) @db.Decimal(14, 2)
  deliveryCharge         Decimal             @default(0) @db.Decimal(14, 2)
  total                  Decimal             @db.Decimal(14, 2)
  paymentMethod          PaymentMethod       @default(COD)
  paymentStatus          PaymentStatus       @default(PENDING)
  notes                  String?
  confirmedAt            DateTime?
  packedAt               DateTime?
  dispatchedAt           DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  createdByUserId        String
  createIdempotencyKey   String              @unique
  confirmIdempotencyKey  String?             @unique
  packIdempotencyKey     String?             @unique
  dispatchIdempotencyKey String?             @unique
  deliverIdempotencyKey  String?             @unique
  cancelIdempotencyKey   String?             @unique
  customer               Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  storeLocation          Location            @relation(fields: [storeLocationId], references: [id], onDelete: Restrict)
  createdBy              User                @relation("CustomerOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                  CustomerOrderItem[]
  reservations           InventoryReservation[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([storeLocationId, createdAt])
}

model CustomerOrderItem {
  id                  String        @id @default(uuid())
  customerOrderId     String
  productId           String
  skuSnapshot         String
  productNameSnapshot String
  quantity            Decimal       @db.Decimal(14, 3)
  unitPrice           Decimal       @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal       @db.Decimal(14, 2)
  customerOrder       CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerOrderId, productId])
  @@index([productId])
}

model InventoryReservation {
  id             String                @id @default(uuid())
  productId      String
  locationId     String
  sourceType     ReservationSourceType
  sourceId       String
  quantity       Decimal               @db.Decimal(14, 3)
  status         ReservationStatus     @default(ACTIVE)
  idempotencyKey String                @unique
  consumedAt     DateTime?
  releasedAt     DateTime?
  customerOrder  CustomerOrder         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())

  @@unique([sourceType, sourceId, productId])
  @@index([productId, locationId, status])
  @@index([sourceType, sourceId])
}

model ReturnRecord {
  id                String           @id @default(uuid())
  returnNumber      String           @unique
  sourceType        ReturnSourceType
  sourceId          String
  kind              ReturnKind
  status            ReturnStatus     @default(COMPLETED)
  refundAmount      Decimal          @default(0) @db.Decimal(14, 2)
  refundMethod      PaymentMethod?
  reason            String
  createdByUserId   String
  completedAt       DateTime
  idempotencyKey    String           @unique
  createdBy         User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items             ReturnItem[]
  createdAt         DateTime         @default(now())

  @@index([sourceType, sourceId, createdAt])
  @@index([completedAt])
  @@map("Return")
}

model ReturnItem {
  id                 String       @id @default(uuid())
  returnId           String
  productId          String
  originalLineId     String
  quantity           Decimal      @db.Decimal(14, 3)
  physicallyReturned Boolean
  restockQuantity    Decimal      @default(0) @db.Decimal(14, 3)
  refundAmount       Decimal      @default(0) @db.Decimal(14, 2)
  returnRecord       ReturnRecord @relation(fields: [returnId], references: [id], onDelete: Restrict)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([returnId, originalLineId])
  @@index([originalLineId])
  @@index([productId])
}

model Payment {
  id               String            @id @default(uuid())
  sourceType       PaymentSourceType
  sourceId         String
  method           PaymentMethod
  status           PaymentStatus
  amount           Decimal           @db.Decimal(14, 2)
  collectedAt      DateTime?
  refundedAmount   Decimal           @default(0) @db.Decimal(14, 2)
  idempotencyKey   String            @unique
  recordedByUserId String
  recordedBy       User              @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sourceType, sourceId])
  @@index([status, createdAt])
  @@index([method, createdAt])
  @@index([recordedByUserId, createdAt])
}

model CashMovement {
  id              String             @id @default(uuid())
  storeLocationId String
  operatingDate   DateTime           @db.Date
  type            CashMovementType
  effect          CashMovementEffect
  amount          Decimal            @db.Decimal(14, 2)
  category        String
  reason          String
  referenceType   String?
  referenceId     String?
  idempotencyKey  String             @unique
  userId          String
  storeLocation   Location           @relation(fields: [storeLocationId], references: [id], onDelete: Restrict)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now())

  @@index([storeLocationId, operatingDate, type])
  @@index([operatingDate, createdAt])
  @@index([referenceType, referenceId])
  @@index([userId, createdAt])
}

model DailyClose {
  id                 String           @id @default(uuid())
  storeLocationId    String
  operatingDate      DateTime         @db.Date
  openingCash        Decimal          @db.Decimal(14, 2)
  cashPosSales       Decimal          @db.Decimal(14, 2)
  codCashCollected   Decimal          @db.Decimal(14, 2)
  cashAdded          Decimal          @db.Decimal(14, 2)
  cashRefunds        Decimal          @db.Decimal(14, 2)
  cashExpenses       Decimal          @db.Decimal(14, 2)
  expectedCash       Decimal          @db.Decimal(14, 2)
  actualCash         Decimal          @db.Decimal(14, 2)
  variance           Decimal          @db.Decimal(14, 2)
  qrNonCashSales     Decimal          @db.Decimal(14, 2)
  pendingCodAmount   Decimal          @db.Decimal(14, 2)
  notes              String?
  status             DailyCloseStatus @default(CLOSED)
  closeIdempotencyKey String          @unique
  closedByUserId     String
  closedAt           DateTime
  reopenIdempotencyKey String?        @unique
  reopenedByUserId   String?
  reopenedAt         DateTime?
  storeLocation      Location         @relation(fields: [storeLocationId], references: [id], onDelete: Restrict)
  closedBy           User             @relation("DailyCloseClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  reopenedBy         User?            @relation("DailyCloseReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([storeLocationId, operatingDate, status])
  @@index([operatingDate, closedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId])
}
