# Application environment: development | test | staging | production
APP_ENV="development"

# PostgreSQL
DATABASE_URL="postgresql://pasalho:pasalho@localhost:5432/pasalho_lite?schema=public"

# Minimum 32 characters outside production.
# Production: unique random value, minimum 48 characters, never commit the real value.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-48-characters"

# Production must use HTTPS.
APP_URL="http://localhost:3000"
SESSION_TTL_HOURS="12"
LOYALTY_EARN_ENABLED="true"
LOYALTY_REDEMPTION_ENABLED="false"

# Authenticated server-to-server connection to modern-trade-website.
# Production must use HTTPS. Use the same random service token in both systems.
# MODERN_PRICING_API_URL="http://localhost:3001"
# MODERN_PRICING_SERVICE_TOKEN="replace-with-a-unique-random-service-token-at-least-32-characters"
# MODERN_PRICING_STORE_REFERENCE="00000000-0000-4000-8000-000000000001"

# Required only when intentionally running the seed command.
# Do not keep production owner credentials in source control.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-a-strong-owner-password"
SEED_OWNER_NAME="Pasalho Owner"

# Controlled first Owner/Admin bootstrap for staging/production only.
# Supply these only for the one-time bootstrap command; do not commit real values.
# BOOTSTRAP_OWNER_EMAIL="owner@example.com"
# BOOTSTRAP_OWNER_PASSWORD="replace-with-a-strong-unique-password"
# BOOTSTRAP_OWNER_NAME="Pasalho Owner"
