# Application environment: development | test | staging | production
APP_ENV="development"

# PostgreSQL
DATABASE_URL="postgresql://pasalho:pasalho@localhost:5432/pasalho_lite?schema=public"

# Minimum 32 characters outside production.
# Production: unique random value, minimum 48 characters, never commit the real value.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-48-characters"

# Production must use HTTPS.
APP_URL="http://localhost:3000"
SESSION_TTL_HOURS="12"

# Required only when intentionally running the seed command.
# Do not keep production owner credentials in source control.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-a-strong-owner-password"
SEED_OWNER_NAME="Pasalho Owner"
