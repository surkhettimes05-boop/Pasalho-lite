{
  "name": "pasalho-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:verify-restore": "tsx scripts/verify-restore.ts",
    "release:e2e": "tsx scripts/canonical-e2e.ts",
    "admin:bootstrap-owner": "tsx scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "csv-parse": "7.0.3",
    "read-excel-file": "9.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "dotenv": "17.2.3",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.23.1"
  }
}
